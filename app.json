{
  "expo": {
    "name": "Family OS",
    "slug": "family-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "familyos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.familyos.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.familyos.app",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.familyos.app.widgets",
          "enablePushNotifications": false,
          "groupIdentifier": "group.com.familyos.app",
          "widgets": [
            {
              "contentMarginsDisabled": false,
              "description": "Shows your active workout, set and rest status.",
              "displayName": "Active Workout",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "name": "FitnessWorkoutActivity",
              "supportedFamilies": [
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
