{
  "expo": {
    "name": "family-os",
    "slug": "family-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "heroui-native-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
